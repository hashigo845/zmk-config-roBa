#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
            layers = <0>;
        };

        bt_next {
            bindings = <&bt BT_NXT>;
            key-positions = <8 9>;
            layers = <1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        hold_tap_kp_kp: hold_tap_kp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        sticky_key: sticky_key {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <200>;
        };

        hold_tap_layer_sticky: hold_tap_layer_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LAYER_STICKY";
            bindings = <&lt>, <&sticky_key>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                      &kp W         &kp E         &kp R           &kp T                                           &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A                      &kp S         &kp D         &kp F           &kp G  &kp LS(LG(S))               &kp MINUS    &kp H          &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z                      &kp X         &kp C         &kp V           &kp B  &kp ESCAPE                  &kp SLASH    &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH
&hold_tap_kp_kp TAB LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &lt 3 LS(CAPS)  &mo 1  &sticky_key LEFT_SHIFT      &lt 2 SPACE  &kp BACKSPACE                             &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans      &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans      &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans      &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp DELETE                                &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        NUM {
            bindings = <
&kp N7        &kp N8        &kp N9        &kp ASTERISK  &kp SLASH                           &trans      &trans  &trans   &trans   &trans
&kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS      &kp MINUS       &trans      &kp F1  &kp F2      &kp F3  &kp F4   &kp F5   &kp F6
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &kp KP_NUMLOCK  &trans      &kp F7  &kp F8      &kp F9  &kp F10  &kp F11  &kp F12
&trans        &kp N0        &kp PERIOD    &trans        &trans          &trans      &trans  &kp DELETE                            &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        symbol {
            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR                             &kp CARET       &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans     &trans           &trans       &trans    &trans      &trans      &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END       &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans     &trans           &trans       &trans    &trans      &trans      &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &trans                &trans
&trans     &trans           &trans       &trans    &trans      &trans      &trans         &kp DELETE                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };
    };
};
